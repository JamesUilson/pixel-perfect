# @tanstack/react-router-ssr-query declares a peer range of >=1.170.33 for
# @tanstack/react-router, but this project is pinned to 1.170.18 because
# @tanstack/react-start 1.168.32 depends on exactly that version. The SSR query
# integration works against it — the hydration fix and the end-to-end journey
# were both verified on this combination — so the peer range is stricter than
# reality and npm would otherwise refuse to install at all.
#
# Revisit when @tanstack/react-start ships a build that pins react-router
# >=1.170.33; then this line can go.
legacy-peer-deps=true
