# ============================================================================
# AVTOQISM web. Copy to .env and adjust. Only VITE_* values reach the browser —
# never put a secret in one.
# ============================================================================

# Base path of the API as the BROWSER sees it.
# Leave as /api/v1 in development (Vite proxies it) and in production (nginx
# serves both on one origin). Set an absolute URL only when the API is on a
# different host.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api. Not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# Nitro build target. node-server produces a Node image for the VPS.
NITRO_PRESET=node-server

# Server-side only. How the SSR process reaches the API when VITE_API_BASE_URL
# is a relative path. In Docker Compose this is the API service name.
API_INTERNAL_URL=http://api:8000
